# Copy to .env.local and fill in.

# Public site URL (canonical, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://www.anantaone.in

# Sales email shown on the site (optional; the brochure doesn't print one)
NEXT_PUBLIC_SALES_EMAIL=

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin (type: Score based / v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score to accept (0.0 bot – 1.0 human)
RECAPTCHA_MIN_SCORE=0.5

# Google Apps Script web app (see google-apps-script/Code.gs): appends to the Sheet and emails sales
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Must match the TOKEN script property in Apps Script
GOOGLE_SCRIPT_TOKEN=

# Optional
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
